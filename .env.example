# StudyBuddy local runtime configuration.
# Set these values in the process environment or an untracked local .env file.
# Never put a real API key in this template or commit a file containing one.

STUDYBUDDY_DATA_ROOT=<local-data-root>
STUDYBUDDY_PROJECT_ID=default
STUDYBUDDY_HOST=127.0.0.1
STUDYBUDDY_PORT=8787
STUDYBUDDY_TASK_MAX_CONCURRENCY=1
STUDYBUDDY_LOG_LEVEL=INFO
# Optional, and must be outside STUDYBUDDY_DATA_ROOT.
# STUDYBUDDY_BACKUP_ROOT=<backup-root>
# Set true only for deterministic local demo; it forces the fake provider and rejects real AI settings.
STUDYBUDDY_DEMO_MODE=false

# Configure all provider values as one matching set. Leave unset for provider-free startup.
# Keys are runtime-only environment values; never commit them or pass them as CLI arguments.
# DeepSeek deepseek-chat is the only provider/model with StudyBuddy real smoke evidence.
# STUDYBUDDY_AI_PROVIDER=deepseek
# STUDYBUDDY_AI_MODEL=deepseek-chat
# STUDYBUDDY_AI_BASE_URL=https://<provider-base-url>
# STUDYBUDDY_AI_API_KEY=<set-locally>

# Stability and response limits.
STUDYBUDDY_AI_TIMEOUT_SECONDS=30
STUDYBUDDY_AI_MAX_RETRIES=0
STUDYBUDDY_AI_MAX_OUTPUT_TOKENS=800
STUDYBUDDY_AI_MAX_PROMPT_CHARS=30000
STUDYBUDDY_AI_MAX_ANSWER_CHARS=12000

# Other OpenAI-compatible providers require their own provider-issued endpoint,
# model ID and key, and remain not_verified until their opt-in smoke gates pass.
# Delivery is safe-off by default; do not enable live delivery in the local v1 release.
STUDYBUDDY_REPORT_DELIVERY_MODE=off
STUDYBUDDY_REPORT_DELIVERY_ENABLED=false
STUDYBUDDY_REPORT_DELIVERY_AUTHORIZED=false
