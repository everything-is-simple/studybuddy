# StudyBuddy local runtime configuration.
# Set these values in the process environment or an untracked local .env file.
# Never put a real API key in this template or commit a file containing one.

STUDYBUDDY_DATA_ROOT=<local-data-root>
STUDYBUDDY_PROJECT_ID=default

# Configure all provider values as one matching set.
# DeepSeek deepseek-chat is the only provider/model with StudyBuddy real smoke evidence.
STUDYBUDDY_AI_PROVIDER=deepseek
STUDYBUDDY_AI_MODEL=deepseek-chat
STUDYBUDDY_AI_BASE_URL=https://<provider-base-url>
STUDYBUDDY_AI_API_KEY=<set-locally>

# Stability and response limits.
STUDYBUDDY_AI_TIMEOUT_SECONDS=30
STUDYBUDDY_AI_MAX_RETRIES=0
STUDYBUDDY_AI_MAX_OUTPUT_TOKENS=800
STUDYBUDDY_AI_MAX_PROMPT_CHARS=30000
STUDYBUDDY_AI_MAX_ANSWER_CHARS=12000

# Other OpenAI-compatible providers require their own provider-issued endpoint,
# model ID and API key, and remain not_verified until their opt-in smoke gates pass.
